# URL base do backend FastAPI (projeto bot_ia_sites), sem barra no final.
# Exemplo local:
VITE_API_BASE_URL=http://localhost:8000

# Opcional: pré-preenche o campo de token admin no painel (mesmo valor que ADMIN_TOKEN no backend).
