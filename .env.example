# URL base do backend FastAPI (projeto bot_ia_sites), sem barra no final.
VITE_API_BASE_URL=https://bot-ia-sites.onrender.com

# Obrigatório no deploy: mesmo valor que ADMIN_TOKEN no backend (Render: Environment do Static Site).
# O usuário final não vê nem preenche isso; é embutido no build.
VITE_ADMIN_TOKEN=defina_o_mesmo_valor_que_ADMIN_TOKEN_na_api
